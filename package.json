{
  "name": "etichettatrice",
  "version": "0.1.0",
  "private": true,
  "description": "Web app open source per progettare e stampare etichette su LabelWriter 550 via WebUSB",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-no-simulator.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test --project=e2e",
    "test:perf": "playwright test --project=perf",
    "test:pwa": "playwright test --project=pwa",
    "test:all": "vitest run && playwright test",
    "lint": "eslint src tests eslint.config.js vite.config.ts playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mbtech-nl/bitmap": "1.3.0",
    "@thermal-label/contracts": "0.6.3",
    "@thermal-label/labelwriter-core": "0.6.4",
    "@thermal-label/labelwriter-web": "0.6.4",
    "fflate": "0.8.3",
    "konva": "10.9.1",
    "pinia": "4.1.0",
    "vosk-browser": "0.0.8",
    "vue": "3.5.44",
    "vue-konva": "4.0.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/w3c-web-usb": "1.0.14",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "opentype.js": "2.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14",
    "workbox-build": "7.4.1"
  }
}
